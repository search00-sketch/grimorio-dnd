rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de usuarios registrados (perfil básico)
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Personajes: cada uno pertenece a un usuario (propietarioUid).
    // Se puede compartir en modo solo-lectura agregando el email
    // de otra persona (por ejemplo el master) al array compartidoCon.
    match /personajes/{personajeId} {

      allow read: if request.auth != null && (
        resource.data.propietarioUid == request.auth.uid ||
        (
          resource.data.compartidoCon is list &&
          request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.compartidoCon
        )
      );

      allow create: if request.auth != null &&
        request.resource.data.propietarioUid == request.auth.uid;

      allow update, delete: if request.auth != null &&
        resource.data.propietarioUid == request.auth.uid;
    }
  }
}
